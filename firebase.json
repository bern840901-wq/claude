{
  "hosting": {
    "target": "twkrpuente",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "pipeline/**",
      "README.md",
      "DEPLOY.md",
      ".gitignore"
    ],
    "redirects": [
      {
        "source": "/pue.html",
        "destination": "/home/",
        "type": 301
      },
      {
        "source": "/preview-pue.png",
        "destination": "/og.png",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.pdf",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
        ]
      }
    ]
  }
}
